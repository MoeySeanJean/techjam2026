# Copy to `.env` and fill in what you have. `.env` is gitignored.
# EVERYTHING IN THIS FILE IS OPTIONAL -- the submission, the benchmarks, the
# tests and the dashboard all work with none of it set.

# --- LLM proposer (build-time only; never on the inference path) -------------
# Any OpenAI-compatible /v1/chat/completions endpoint works. Pick one:
#
#   NUS SoC LaaS (what we used). The model is measured, not guessed: we ran
#   every model the key can reach through the kernel-writing loop and counted
#   correct kernels. qwen3.8:27b won at 16/20; the next best managed 8/20.
#
#   Two warnings if you point this at your own gateway:
#     * `scripts/pick_model.py` scores plan JSON only, and on ours it was
#       ANTI-predictive -- it ranked first a model that wrote 0 working kernels
#       out of 20. Trust docs/CODEGEN.md's method, not the JSON score.
#     * ours silently aliases model ids (asking for qwen3.6:27b gets you
#       qwen3.8:27b). Check the `model` field the API echoes back.
LLM_BASE_URL=https://soclaas-api.comp.nus.edu.sg/v1
LLM_API_KEY=clsk_xxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=qwen3.8:27b
#
#   OpenAI
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
#
#   Ollama, local, no key required (any placeholder is accepted)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5-coder:7b
#
#   vLLM / LM Studio / your own gateway
# LLM_BASE_URL=http://localhost:8000/v1
#
# `OPENAI_*` and `SOCLAAS_*` are accepted as aliases, in that order, so an
# environment that already exports OPENAI_API_KEY needs no new variables.
# Or use Anthropic directly:
# ANTHROPIC_API_KEY=sk-ant-...

# --- NUS Slurm cluster (scripts/cluster.py) ---------------------------------
# Only needed to reproduce our A100/H100 runs on that specific cluster.
# NUS_USER=your_username
# NUS_PASS=your_password
